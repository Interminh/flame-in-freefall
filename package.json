{
  "name": "flame-in-freefall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sim:calibrate": "node scripts/sim/calibrate.mjs && node scripts/sim/fm2.mjs",
    "test:sim": "node --test tests/sim/model.test.mjs tests/sim/warnings.test.mjs",
    "data": "python3 scripts/pipeline/build_data.py && python3 scripts/pipeline/build_dictionary.py && python3 scripts/pipeline/build_corpus.py && python3 scripts/pipeline/build_meta.py",
    "test:data": "node --test tests/data/integrity.test.mjs tests/data/charts.test.mjs tests/data/query.test.mjs",
    "test": "npm run test:sim && npm run test:data"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "plotly.js-dist-min": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
