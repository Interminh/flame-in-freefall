# Copy to .env and fill in real values. Never commit .env.
# For the live site, set these in Vercel (Project, Settings, Environment Variables).

# Key for the hosted model provider (Groq by default). Server only.
LLM_API_KEY=

# Optional. Defaults shown. Check the provider for the current model name.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Local Ollama instead (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
