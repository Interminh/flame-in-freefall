# Copy to .env and fill in real values. Never commit .env.
# For the live site, set these in Vercel (Project, Settings, Environment Variables).
# The app works without any of these: the Ask panel then answers with cited passages only.

# Key for the hosted model provider. Server only; never sent to the browser.
LLM_API_KEY=

# Optional. "openai" means any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama). Or "anthropic".
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Local Ollama instead (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# Optional keys that lift rate limits on public research APIs used by the Studio page.
# OPENALEX_API_KEY=
# S2_API_KEY=
